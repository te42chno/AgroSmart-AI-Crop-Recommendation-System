# VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# Create a copy of this file named ".env" and put your actual key there.
# Never commit your real key to source control.
VITE_GEMINI_API_KEY=""

# VITE_APP_URL: The URL where this app is hosted.
# For local development you can set this to "http://localhost:3000".
VITE_APP_URL="http://localhost:3000"

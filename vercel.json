{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/ml-api/(.*)",
      "destination": "/api/ml.py"
    }
  ],
  "functions": {
    "api/ml.py": {
      "runtime": "vercel-python@0.1.0"
    }
  }
}
